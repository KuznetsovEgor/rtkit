FROM node:22-alpine AS realm
WORKDIR /src
COPY scripts/build-public-realm.mjs scripts/public-origin.mjs ./scripts/
COPY infra/keycloak/lct-realm.json ./infra/keycloak/lct-realm.json
ARG WEB_ORIGIN
ARG KEYCLOAK_PUBLIC_ORIGIN
RUN WEB_ORIGIN="$WEB_ORIGIN" KEYCLOAK_PUBLIC_ORIGIN="$KEYCLOAK_PUBLIC_ORIGIN" node scripts/build-public-realm.mjs

FROM quay.io/keycloak/keycloak:26.3
COPY --from=realm --chown=1000:0 /src/.local-storage/public-realm/lct-realm.json /opt/keycloak/data/import/lct-realm.json
COPY infra/keycloak/themes/rtk-crm /opt/keycloak/themes/rtk-crm
ENTRYPOINT ["/opt/keycloak/bin/kc.sh"]
CMD ["start", "--import-realm", "--proxy-headers=xforwarded"]
