FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY api ./api
COPY scripts/provision-public-demo-accounts.mjs ./scripts/provision-public-demo-accounts.mjs
RUN npx tsc -p api/tsconfig.json && npm prune --omit=dev

FROM node:22-alpine AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/api/dist ./api/dist
COPY --from=build /app/api/migrations ./api/migrations
COPY --from=build /app/api/assets ./api/assets
COPY --from=build /app/scripts/provision-public-demo-accounts.mjs ./scripts/provision-public-demo-accounts.mjs
COPY deploy/public-demo/api-entrypoint.sh /usr/local/bin/api-entrypoint
RUN chmod 0555 /usr/local/bin/api-entrypoint && mkdir -p /data && chown node:node /data
USER node
EXPOSE 3001
ENTRYPOINT ["/usr/local/bin/api-entrypoint"]
